---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "DON",
    subtitle: "Persönliches AI-Betriebssystem",
    bullets: [
      "Persistentes Gedächtnis über Sessions hinweg. Das System lernt, was zählt.",
      "50+ Skills. Recherche, Analyse, Schreiben, Diagramme, Sicherheitsprüfungen, Brainstorming.",
      "Mehrere Agenten parallel an einer Aufgabe. Nicht ein Chat, ein Team.",
      "Kennt meinen Schreibstil, meine Denkweise, meinen Kontext."
    ],
    tags: ["Claude Code", "TypeScript", "Agent SDK"]
  },
  {
    title: "Second Brain",
    subtitle: "Obsidian",
    bullets: [
      "Alles verlinkt, alles durchsuchbar. Ziele, Ideen, Projekte, Erkenntnisse.",
      "Neue Inhalte werden automatisch gegen bestehendes Wissen geprüft.",
      "Was in einer Session passiert, fließt als Nebenprodukt ins System."
    ],
    tags: ["Obsidian", "Wissensmanagement"]
  },
  {
    title: "Infrastruktur",
    subtitle: "Was unter der Haube steckt",
    bullets: [
      "<strong>Memory-System:</strong> Zwei Ebenen. Kurzzeit-Feedback pro Session, Langzeit-Erkenntnisse über Monate.",
      "<strong>Event-Hooks:</strong> Das System reagiert auf Ereignisse. Session endet, Datei ändert sich, Backup wird erstellt.",
      "<strong>Modulare Architektur:</strong> Jede Fähigkeit ist ein eigenes Paket mit Abläufen, Werkzeugen und Qualitätsprüfungen.",
      "<strong>Sicherheit:</strong> Erkennung von Datenabfluss, automatische Backups, geschützte Systembereiche.",
      "<strong>Selbstverbesserung:</strong> Das System analysiert seine eigenen Fähigkeiten und kann sie vereinfachen oder neue erstellen."
    ],
    tags: ["Hooks", "Memory", "Sicherheit"]
  }
]
---

<BaseLayout title="DON AI Systems">
  <div class="container">
    <aside class="sidebar">
      <div class="bio">
        <img src="/don-logo.png" alt="DON" class="logo" />
        <h1>DON AI Systems</h1>
        <p class="tagline">Persönliche AI Infrastruktur</p>

        <div class="about">
          <p>Die meisten nutzen AI-Tools im Chatfenster und wundern sich, dass sie generische Antworten bekommen.</p>
          <p>Ich baue Infrastruktur drumrum: Kontext sammeln, Systeme aufsetzen, Skills, Memory, automatische Verbesserungen. Modelle werden irgendwann alle gut genug sein. Der eigene Kontext, die eigene Infrastruktur. Das ist der Hebel, den man selbst in der Hand hat.</p>
          <p>Ein System, das dich kennt und mitdenkt. Das ist DON.</p>
        </div>

        <div class="details">
          <div class="detail-item">
            <span class="label">Stack</span>
            <span>Claude Code, Obsidian, TypeScript</span>
          </div>
          <div class="detail-item">
            <span class="label">Fokus</span>
            <span>AI Infrastructure, Knowledge Systems</span>
          </div>
        </div>

        <div class="links">
          <a href="mailto:info@donsystems.de">info@donsystems.de</a>
        </div>
      </div>
    </aside>

    <main class="content">
      <section class="projects">
        <h2>Bausteine</h2>
        {projects.map((project) => (
          <article class="project">
            <h3>{project.title}</h3>
            {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
            <ul class="project-bullets">
              {project.bullets.map((bullet) => (
                <li set:html={bullet} />
              ))}
            </ul>
            <div class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </section>
    </main>
  </div>

  <style>
    .container {
      display: flex;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .sidebar {
      position: sticky;
      top: 0;
      width: 400px;
      min-width: 400px;
      height: 100vh;
      padding: 4rem 3rem 4rem 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .bio {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
    }

    h1 {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 2.8rem;
      line-height: 1.1;
      color: var(--text);
      letter-spacing: -0.02em;
    }

    .tagline {
      font-family: var(--font-body-alt);
      font-size: 1.05rem;
      color: var(--text-light);
      font-weight: 400;
    }

    .about p {
      font-size: 0.95rem;
      color: var(--text);
      margin-bottom: 0.8rem;
      line-height: 1.7;
    }

    .about p:last-child {
      margin-bottom: 0;
    }

    .details {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-top: 0.5rem;
    }

    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      font-family: var(--font-ui);
      font-size: 0.85rem;
    }

    .label {
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
    }

    .links {
      display: flex;
      gap: 1.5rem;
      padding-top: 0.5rem;
    }

    .links a {
      font-family: var(--font-ui);
      font-size: 0.85rem;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      padding-bottom: 2px;
      transition: border-color 0.2s;
    }

    .links a:hover {
      border-color: var(--text);
    }

    .content {
      flex: 1;
      padding: 4rem 0 4rem 3rem;
      border-left: 1px solid var(--border);
    }

    h2 {
      font-family: var(--font-headline);
      font-weight: 400;
      font-style: italic;
      font-size: 1.8rem;
      line-height: 1.2;
      color: var(--text);
      letter-spacing: -0.01em;
      margin-bottom: 2.5rem;
    }

    .projects {
      margin-bottom: 4rem;
    }

    .project {
      margin-bottom: 2.5rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--border);
    }

    .project:last-child {
      border-bottom: none;
    }

    .project h3 {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--text);
      margin-bottom: 0.4rem;
    }

    .project-subtitle {
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 0.6rem;
    }

    .project-bullets {
      font-size: 0.92rem;
      color: var(--text);
      line-height: 1.7;
      margin-bottom: 0.8rem;
      padding-left: 1.2rem;
    }

    .project-bullets li {
      margin-bottom: 0.2rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .tag {
      font-family: var(--font-ui);
      font-size: 0.72rem;
      color: var(--text-light);
      background: var(--tag-bg);
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
    }

    @media (max-width: 768px) {
      .container {
        flex-direction: column;
        padding: 0 1.5rem;
      }

      .sidebar {
        position: relative;
        width: 100%;
        min-width: unset;
        height: auto;
        padding: 3rem 0 2rem;
      }

      .content {
        padding: 2rem 0 3rem;
        border-left: none;
        border-top: 1px solid var(--border);
      }

      .logo {
        width: 48px;
        height: 48px;
      }

      h1 {
        font-size: 2.2rem;
      }
    }
  </style>
</BaseLayout>
