---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("de-DE", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout title={`${post.data.title} | DON AI Systems`} description={post.data.lede ?? post.data.title}>
  <article class="post">
    <aside class="post-meta">
      <h1>{post.data.title}</h1>
      {post.data.lede && <p class="lede">{post.data.lede}</p>}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.tags && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
      <a href="/blog" class="back-link">← Zurück zum Blog</a>
    </aside>

    <div class="post-body">
      <Content />
    </div>
  </article>

  <style>
    .post {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 4rem;
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    .post-meta {
      position: sticky;
      top: 2rem;
      align-self: start;
      padding-right: 2rem;
      border-right: 1px solid var(--border);
    }

    .post-meta h1 {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.7rem;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--text);
      margin-bottom: 1rem;
    }

    .post-meta .lede {
      font-family: var(--font-headline);
      font-style: italic;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--text-light);
      margin-bottom: 1.5rem;
    }

    .post-meta time {
      display: block;
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .tag {
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--text-light);
    }

    .back-link {
      display: inline-block;
      font-family: var(--font-ui);
      font-size: 0.85rem;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      padding-bottom: 2px;
      transition: border-color 0.2s;
    }

    .back-link:hover {
      border-color: var(--text);
    }

    .post-body {
      max-width: 680px;
      font-family: var(--font-body);
      font-size: 1.1rem;
      line-height: 1.78;
      color: var(--text);
    }

    .post-body :global(p:first-child) {
      font-family: var(--font-headline);
      font-style: italic;
      font-weight: 400;
      font-size: 1.32rem;
      line-height: 1.5;
      letter-spacing: -0.005em;
      color: var(--text);
      margin-bottom: 2.2rem;
      text-wrap: pretty;
    }

    .post-body :global(h2) {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.85rem;
      line-height: 1.18;
      letter-spacing: -0.018em;
      margin: 3.5rem 0 1.2rem;
      color: var(--text);
      text-wrap: balance;
    }

    .post-body :global(h3) {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.28rem;
      line-height: 1.3;
      letter-spacing: -0.005em;
      margin: 2.6rem 0 0.9rem;
      color: var(--text);
      text-wrap: balance;
    }

    .post-body :global(h4) {
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--accent);
      margin: 2.8rem 0 1rem;
    }

    .post-body :global(p) {
      margin-bottom: 1.5rem;
    }

    .post-body :global(strong) {
      font-weight: 700;
      letter-spacing: -0.005em;
      color: var(--text);
    }

    .post-body :global(em) {
      font-style: italic;
    }

    .post-body :global(a) {
      color: var(--text);
      text-decoration: none;
      background-image: linear-gradient(var(--accent), var(--accent));
      background-size: 100% 1px;
      background-position: 0 100%;
      background-repeat: no-repeat;
      padding-bottom: 1px;
      transition: background-size 0.2s ease, color 0.2s ease;
    }

    .post-body :global(a:hover) {
      background-size: 100% 2px;
      color: var(--accent);
    }

    .post-body :global(blockquote) {
      border-left: 2px solid var(--accent);
      padding: 0.3rem 0 0.3rem 1.6rem;
      margin: 2rem 0 2.2rem;
      font-family: var(--font-headline);
      font-style: italic;
      font-size: 1.15rem;
      line-height: 1.55;
      color: var(--text-light);
    }

    .post-body :global(blockquote p) {
      margin-bottom: 0.6rem;
    }

    .post-body :global(blockquote p:last-child) {
      margin-bottom: 0;
    }

    .post-body :global(hr) {
      border: none;
      height: 1px;
      width: 80px;
      background: var(--border);
      margin: 3rem auto;
    }

    .post-body :global(ul) {
      list-style: none;
      margin: 0 0 1.6rem 0;
      padding-left: 1.6rem;
    }

    .post-body :global(ul li) {
      position: relative;
      margin-bottom: 0.6rem;
      line-height: 1.7;
    }

    .post-body :global(ul li::before) {
      content: "";
      position: absolute;
      left: -1.1rem;
      top: 0.78em;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent);
    }

    .post-body :global(ol) {
      list-style: none;
      counter-reset: editorial-list;
      margin: 0 0 1.6rem 0;
      padding-left: 0;
    }

    .post-body :global(ol li) {
      counter-increment: editorial-list;
      position: relative;
      padding-left: 2.6rem;
      margin-bottom: 0.8rem;
      line-height: 1.7;
    }

    .post-body :global(ol li::before) {
      content: counter(editorial-list);
      position: absolute;
      left: 0;
      top: 0.05em;
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--accent);
      width: 1.8rem;
      text-align: right;
      padding-right: 0.5rem;
      letter-spacing: 0.04em;
    }

    .post-body :global(li > ul),
    .post-body :global(li > ol) {
      margin-top: 0.6rem;
      margin-bottom: 0.4rem;
    }

    .post-body :global(code) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.9em;
      background: var(--tag-bg);
      padding: 0.12em 0.4em;
      border-radius: 3px;
      color: var(--text);
    }

    .post-body :global(pre) {
      background: var(--tag-bg);
      padding: 1.2rem 1.4rem;
      border-radius: 4px;
      overflow-x: auto;
      margin: 1.8rem 0;
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .post-body :global(pre code) {
      background: transparent;
      padding: 0;
      font-size: 1em;
    }

    .post-body :global(img) {
      max-width: 100%;
      height: auto;
      margin: 2rem 0;
      border-radius: 4px;
    }

    @media (max-width: 900px) {
      .post {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        padding: 2.5rem 1.5rem;
      }

      .post-meta {
        position: static;
        padding-right: 0;
        padding-bottom: 2rem;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }
    }
  </style>
</BaseLayout>
