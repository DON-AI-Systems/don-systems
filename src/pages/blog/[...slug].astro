---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("de-DE", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout title={`${post.data.title} | DON AI Systems`} description={post.data.lede ?? post.data.title}>
  <article class="post">
    <aside class="post-meta">
      <h1>{post.data.title}</h1>
      {post.data.lede && <p class="lede">{post.data.lede}</p>}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.tags && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
      <a href="/blog" class="back-link">← Zurück zum Blog</a>
    </aside>

    <div class="post-body">
      <Content />
    </div>
  </article>

  <style>
    .post {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 4rem;
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    .post-meta {
      position: sticky;
      top: 2rem;
      align-self: start;
      padding-right: 2rem;
      border-right: 1px solid var(--border);
    }

    .post-meta h1 {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.7rem;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--text);
      margin-bottom: 1rem;
    }

    .post-meta .lede {
      font-family: var(--font-headline);
      font-style: italic;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--text-light);
      margin-bottom: 1.5rem;
    }

    .post-meta time {
      display: block;
      font-family: var(--font-caps);
      font-weight: 600;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .tag {
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--text-light);
    }

    .back-link {
      display: inline-block;
      font-family: var(--font-ui);
      font-size: 0.85rem;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      padding-bottom: 2px;
      transition: border-color 0.2s;
    }

    .back-link:hover {
      border-color: var(--text);
    }

    .post-body {
      max-width: 680px;
      font-family: var(--font-body);
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--text);
    }

    .post-body :global(h2) {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.5rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
      margin: 2.5rem 0 1rem;
      color: var(--text);
    }

    .post-body :global(h3) {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.2rem;
      line-height: 1.3;
      margin: 2rem 0 0.8rem;
      color: var(--text);
    }

    .post-body :global(p) {
      margin-bottom: 1.2rem;
    }

    .post-body :global(ul),
    .post-body :global(ol) {
      margin: 0 0 1.4rem 1.4rem;
    }

    .post-body :global(li) {
      margin-bottom: 0.5rem;
    }

    .post-body :global(strong) {
      font-weight: 700;
    }

    .post-body :global(em) {
      font-style: italic;
    }

    .post-body :global(a) {
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid var(--accent);
      transition: color 0.2s;
    }

    .post-body :global(a:hover) {
      color: var(--accent);
    }

    .post-body :global(blockquote) {
      border-left: 3px solid var(--accent);
      padding-left: 1.2rem;
      margin: 1.5rem 0;
      font-style: italic;
      color: var(--text-light);
    }

    .post-body :global(code) {
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.92em;
      background: var(--tag-bg);
      padding: 0.1em 0.35em;
      border-radius: 3px;
    }

    .post-body :global(pre) {
      background: var(--tag-bg);
      padding: 1rem;
      border-radius: 4px;
      overflow-x: auto;
      margin: 1.5rem 0;
    }

    .post-body :global(pre code) {
      background: transparent;
      padding: 0;
    }

    @media (max-width: 900px) {
      .post {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        padding: 2.5rem 1.5rem;
      }

      .post-meta {
        position: static;
        padding-right: 0;
        padding-bottom: 2rem;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }
    }
  </style>
</BaseLayout>
